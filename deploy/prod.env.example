# Copy to deploy/prod.env (gitignored) and fill in. Secrets belong in your
# platform's secret store; this file is the shape, not the place to keep them.

SERVICE_NAME=customer-service
SERVICE_ENV=production
HTTP_ADDR=:8080

STORE_DRIVER=postgres
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/customers?sslmode=require

# Leave migrations to the service, or set false and apply the schema yourself.
DB_AUTO_MIGRATE=true
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

LOG_LEVEL=info
LOG_FORMAT=json
