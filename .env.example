# Dev mode only: copy to .env and adjust. `make dev` and `make dev-run` source
# it after applying their own defaults, so anything here wins. Stage and prod
# read deploy/stage.env and deploy/prod.env instead.
#
# Every value shown is the service default.

# --- service identity -------------------------------------------------------
SERVICE_NAME=customer-service
SERVICE_ENV=development

# --- http -------------------------------------------------------------------
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_BODY_BYTES=1048576

# --- storage ----------------------------------------------------------------
# sqlite (development) or postgres
STORE_DRIVER=sqlite
SQLITE_DSN=file:./data/customers.db
# Required when STORE_DRIVER=postgres
# DATABASE_URL=postgres://customers:customers@localhost:5432/customers?sslmode=disable
DB_AUTO_MIGRATE=true
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=5m
DB_PING_TIMEOUT=5s

# --- paging -----------------------------------------------------------------
PAGE_SIZE_DEFAULT=50
PAGE_SIZE_MAX=500

# --- logging ----------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
