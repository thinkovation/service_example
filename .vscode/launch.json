{
	// Press F5 to run the service under the debugger against local SQLite.
	// Needs the Go extension (golang.go), which installs Delve on first use.
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug service (SQLite)",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/cmd/customersvc",
			"cwd": "${workspaceFolder}",
			"env": {
				"SERVICE_ENV": "development",
				"STORE_DRIVER": "sqlite",
				"SQLITE_DSN": "file:./data/customers.db",
				"HTTP_ADDR": ":8080",
				"LOG_FORMAT": "text",
				"LOG_LEVEL": "debug"
			}
		},
		{
			// Run the "stage: up" task first so the database is there.
			"name": "Debug service (stage Postgres)",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/cmd/customersvc",
			"cwd": "${workspaceFolder}",
			"env": {
				"SERVICE_ENV": "development",
				"STORE_DRIVER": "postgres",
				"DATABASE_URL": "postgres://customers:customers@localhost:5432/customers?sslmode=disable",
				"HTTP_ADDR": ":8080",
				"LOG_FORMAT": "text",
				"LOG_LEVEL": "debug"
			}
		},
		{
			"name": "Debug the current test file",
			"type": "go",
			"request": "launch",
			"mode": "test",
			"program": "${fileDirname}"
		}
	]
}
